---
layout: layouts/base
title: Home
permalink: /
main: true
---

<div class="form">
  <form class="pure-form" id="color-entry-form" action="#" method="post" name="color-entry-form">
    <div class="labels">
      <div class="form-warning" id="warning">Please enter at least one valid hex color.</div>
      <h2><label class="textarea-label" for="color-values">Enter hex colors (separated by spaces)</label></h2>
    </div>

    <div class="input">
      <textarea id="color-values" name="color-values" autocomplete="off" autocapitalize="off" spellcheck="false"></textarea>
    </div>

    <!-- ToneMaster controls -->
    <div class="input" style="margin-top:.75rem">
      <label for="mode" class="textarea-label">Mode</label>
      <select id="mode" name="mode">
        <option value="default">Default (10%)</option>
        <option value="steps">Custom Steps</option>
        <option value="single">Single %</option>
      </select>
    </div>

    <div class="input" style="margin-top:.75rem; display:none" id="step-wrapper">
      <label for="step-size" class="textarea-label">Step %</label>
      <input id="step-size" name="step-size" type="number" value="10" min="1" max="50" step="1" style="width:8rem">
    </div>

    <div class="input" style="margin-top:.75rem; display:none" id="single-wrapper">
      <label for="single-percent" class="textarea-label">Single %</label>
      <input id="single-percent" name="single-percent" type="number" value="25" min="1" max="99" step="1" style="width:8rem">
    </div>

    <div class="input" style="margin-top:.75rem">
      <label for="format" class="textarea-label">Format</label>
      <select id="format" name="format">
        <option value="hex">HEX</option>
        <option value="rgb">RGB</option>
        <option value="hsl">HSL</option>
      </select>
    </div>

<label class="switch" tabindex="0" style="margin-top:.5rem; margin-bottom:1rem; display:block">
  <input type="checkbox" id="copy-hex-uppercase" tabindex="-1">
  <span class="control"></span>
  <span class="label">Copy HEX in UPPERCASE</span>
</label>

    <input id="make" class="button" type="submit" value="Make ToneMaster &nbsp;🎉">
  </form>
</div>



<div class="hashtag-selector" id="scroll-top">
  <label class="switch" tabindex="0">
    <input type="checkbox" id="copy-with-hashtag" tabindex="-1">
    <span class="control"></span>
    <span class="label">Include hashtag when copying</span>
  </label>
</div>

<!-- Accessibility panel -->
<div class="input" style="margin-top:1rem">
  <h3 style="margin:0 0 .5rem 0">Accessibility</h3>

  <div style="display:flex; gap:1rem; flex-wrap:wrap; align-items:center">
    <!-- Rating -->
    <label>
      Rating&nbsp;
      <select id="a11y-enabled" name="a11y-enabled">
        <option value="off">Off</option>
        <option value="AA">AA</option>
        <option value="AAA">AAA</option>
      </select>
    </label>

    <!-- Background -->
    <label>
      Background&nbsp;
      <select id="a11y-bg-mode" name="a11y-bg-mode">
        <option value="white">White</option>
        <option value="black">Black</option>
        <option value="custom">Custom</option>
      </select>
    </label>
    <input id="a11y-bg-custom" type="color" value="#ffffff" style="width:3rem; height:2rem; padding:0; border:none; display:none">
    <input id="a11y-bg-hex" type="text" value="#ffffff" placeholder="#ffffff" style="width:9rem; display:none">

    <!-- Text size -->
    <label>
      Text size&nbsp;
      <select id="a11y-size" name="a11y-size">
        <option value="normal">Normal</option>
        <option value="large">Large</option>
      </select>
    </label>
  </div>

  <p class="tm-tip" style="margin-top:.5rem">
    WCAG thresholds: AA (normal ≥ 4.5:1, large ≥ 3:1), AAA (normal ≥ 7:1, large ≥ 4.5:1)
  </p>
</div>

<div class="ads">
  <script async type="text/javascript" src="//cdn.carbonads.com/carbon.js?serve=CW7ILKQU&placement=maketintsandshadescom&format=cover" id="_carbonads_js"></script>
</div>

<div class="palettes">
  <div id="tonemaster"></div>
</div>
